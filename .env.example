# RAG Pipeline Environment Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Vector Store Configuration
VECTOR_STORE_TYPE=chromadb
CHROMADB_PATH=./data/chromadb

# Optional: Qdrant Configuration (for production)
# VECTOR_STORE_TYPE=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-api-key

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./models/embeddings
EMBEDDING_DEVICE=cpu

# For GPU acceleration (if available):
# EMBEDDING_DEVICE=cuda

# Chunking Strategy Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
USE_SEMANTIC_CHUNKING=false
USE_PARENT_CHILD_CHUNKING=true
PARENT_CHUNK_SIZE=1024
CHILD_CHUNK_SIZE=256

# Document Processing
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=100

# Retrieval Configuration
TOP_K=5
MIN_SIMILARITY_SCORE=0.0

# Generation (LLM) Configuration
GEMINI_API_KEY=your-gemini-api-key
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
ABSTAIN_THRESHOLD=0.35

# Kaggle Integration (optional)
# KAGGLE_USERNAME=your-username
# KAGGLE_KEY=your-api-key
